{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "frontend-route": {
        "ClusterId": "frontend-cluster",
        "Match": {
          "Path": "{**catch-all}"
        },
        "Order": 2
      },
      "backend-route": {
        "ClusterId": "backend-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Order": 1,
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "X-Forwarded": "Set" }
        ]
      }
    },
    "Clusters": {
      "frontend-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://frontend-ui:80/"
          }
        }
      },
      "backend-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://backend-api:8080/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}